{
  "name": "retail-inventory-expiry-management-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for retail inventory and expiry management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node -r dotenv/config --test",
    "db:migrate": "node-pg-migrate up --migrations-dir db/migrations --database-url-var DATABASE_URL_UNPOOLED --envPath .env",
    "db:migrate:test": "node-pg-migrate up --migrations-dir db/migrations --database-url-var TEST_DATABASE_URL --envPath .env"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.1"
  }
}
